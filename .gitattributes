# WSL Plugin Sample - Git Attributes Configuration
# Prevent CRLF line ending issues

# Text files should always use LF line endings
*.md text eol=lf
*.txt text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.nix text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Configuration files
Makefile text eol=lf
*.mk text eol=lf
*.cmake text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
Dockerfile* text eol=lf

# Windows-specific files that should keep CRLF
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.vcxproj.filters text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
README* text eol=lf
LICENSE* text eol=lf
CHANGELOG* text eol=lf

# Binary files
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.obj binary
*.o binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
*.tgz binary